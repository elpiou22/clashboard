{% extends 'layouts/base.html.twig' %}
{% block title %} Forum {% endblock title %}
{% block head %}
  <link rel="stylesheet" href="{{ asset('css/margins.css') }}">
  <link rel="stylesheet" href="{{ asset('css/forum_cwl.css') }}">
  <link rel="stylesheet" href="{{ asset('css/colors.css') }}">
  <script src="{{ asset('js/forum.js') }}" defer></script>
  <script src="{{ asset('js/change_title.js') }}" defer></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
{% endblock head %}


{% block body %}
  <div style="display: none" id="date">{{ date }}</div>
  <div class="body_container">
  <div class="all_container">
    <span class="main_title">{{ clanInfos }}</span>
    <div class="data_container beige">
      <div class="title_container green">
        <h2>{{ attackerName }} Day {{ attackDay }}</h2>

        <div class="result">
          <strong>Résultat actuel:</strong> {{ attackResult }}
        </div>
        <p style="font-weight: bold;">{{ attackInfos|nl2br }}</p>
      </div>

      <hr class="separator">
        <div class="button" onclick="back_at_beginning('{{ clanId }}', '{{ date }}', '{{ '%02d'|format(firstarg) }}', '{{ secondarg }}')">
          Retour au début
        </div>
      <hr class="separator">

      <div class="posts_container" id="posts_container">
        {% for post in parentChain %}
          <div class="post">
            <div class="author">
              <span>{{ post.getAuthorUsername(entityManager) }}</span>
            </div>

            <div class="content">{{ post.getText }}</div>
            <div class="actions">
              <div class="button" onclick="vote(this, {{ post.getId }}, 'up')">
                <span class="number_of">{{ post.getUpvote }}</span>
                <svg class="svgbutton" viewBox="0 0 24 24" width="24" height="24">
                  <path fill="white" d="M12.781 2.375c-.381-.475-1.181-.475-1.562 0l-8 10A1.001 1.001 0 0 0 4 14h4v7a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-7h4a1.001 1.001 0 0 0 .781-1.625l-8-10zM15 12h-1v8h-4v-8H6.081L12 4.601 17.919 12H15z"/>
                </svg>
              </div>
              <div class="button" onclick="vote(this, {{ post.getId }}, 'down')">
                <span class="number_of">{{ post.getDownvote }}</span>
                <svg class="svgbutton down" viewBox="0 0 24 24" width="24" height="24">
                  <path fill="white" d="M12.781 2.375c-.381-.475-1.181-.475-1.562 0l-8 10A1.001 1.001 0 0 0 4 14h4v7a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-7h4a1.001 1.001 0 0 0 .781-1.625l-8-10zM15 12h-1v8h-4v-8H6.081L12 4.601 17.919 12H15z"/>
                </svg>
              </div>
              {% if post.getNbReplies == 1 %}
              <div class="button reply_script">
                {% else %}
                <div class="button" onclick="full_reply({{ post.getId }})">
                  {% endif %}
                <span class="number_of">{{ post.getNbReplies }}</span>
                <svg viewBox="0 0 24 24" width="24" height="24">
                  <path fill="white" d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.37 2.77 6.08 6.138 6.01l.351-.01h1.761v2.3l5.087-2.81c1.951-1.08 3.163-3.13 3.163-5.36 0-3.39-2.744-6.13-6.129-6.13H9.756z"></path>
                </svg>
              </div>
            </div>
            {% if last_post == post.getId %}
            <div class="reply-box" style="display: flex !important;">
            {% else %}
            <div class="reply-box" style="display: none;">
            {% endif %}
              <div class="label_container">
                <textarea placeholder="Votre réponse..."></textarea>
              </div>
              <div class="button_container">
                <button class="send-reply" onclick="call_controller(this, {{ post.getId }})">Envoyer</button>
              </div>
            </div>
          </div>
        {% endfor %}
        <hr class="separator"></hr>
        {% for reply in replies %}
          <div class="post reply">
            <div class="author">
              <span>{{ reply.getAuthorUsername(entityManager) }}</span>
            </div>

            <div class="content">{{ reply.getText }}</div>
            <div class="actions">
              <div class="button" onclick="vote(this, {{ reply.getId }}, 'up')">
                <span class="number_of">{{ reply.getUpvote }}</span>
                <svg class="svgbutton" viewBox="0 0 24 24" width="24" height="24">
                  <path fill="white" d="M12.781 2.375c-.381-.475-1.181-.475-1.562 0l-8 10A1.001 1.001 0 0 0 4 14h4v7a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-7h4a1.001 1.001 0 0 0 .781-1.625l-8-10zM15 12h-1v8h-4v-8H6.081L12 4.601 17.919 12H15z"/>
                </svg>
              </div>
              <div class="button" onclick="vote(this, {{ reply.getId }}, 'down')">
                <span class="number_of">{{ reply.getDownvote }}</span>
                <svg class="svgbutton down" viewBox="0 0 24 24" width="24" height="24">
                  <path fill="white" d="M12.781 2.375c-.381-.475-1.181-.475-1.562 0l-8 10A1.001 1.001 0 0 0 4 14h4v7a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-7h4a1.001 1.001 0 0 0 .781-1.625l-8-10zM15 12h-1v8h-4v-8H6.081L12 4.601 17.919 12H15z"/>
                </svg>
              </div>
              {% if reply.getNbReplies == 0 %}
              <div class="button reply_script">
              {% else %}
              <div class="button" onclick="full_reply({{ reply.getId }})">
              {% endif %}
                <span class="number_of">{{ reply.getNbReplies }}</span>
                <svg viewBox="0 0 24 24" width="24" height="24">
                  <path fill="white" d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.37 2.77 6.08 6.138 6.01l.351-.01h1.761v2.3l5.087-2.81c1.951-1.08 3.163-3.13 3.163-5.36 0-3.39-2.744-6.13-6.129-6.13H9.756z"></path>
                </svg>
              </div>
            </div>
            <div class="reply-box" style="display: none;">
              <div class="label_container">
                <textarea placeholder="Votre réponse..."></textarea>
              </div>
              <div class="button_container">
                <button class="send-reply" onclick="call_controller(this, {{ reply.getId }})">Envoyer</button>
              </div>
            </div>
          </div>

        {% endfor %}
        </div>
      </div>
    </div>
  </div>


{% endblock body %}