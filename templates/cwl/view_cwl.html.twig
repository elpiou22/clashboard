{% extends 'layouts/base.html.twig' %}
{% block title %} CWL {% endblock title %}
{% block extra_styles %}
  <meta charset="UTF-8">
  <link rel="stylesheet" href="{{ asset('css/style_cwl.css') }}">
  <link rel="stylesheet" href="{{ asset('css/margins.css') }}">
  <link rel="stylesheet" href="{{ asset('css/widths.css') }}">
  <link rel="stylesheet" href="{{ asset('css/fonts.css') }}">
  <link rel="stylesheet" href="{{ asset('css/colors.css') }}">
  <script src="{{ asset('js/change_width_td.js') }}" defer></script>
  <script src="{{ asset('js/get_cell_index.js') }}" defer></script>
  <script src="{{ asset('js/fades-in-out.js') }}" defer></script>
  <script src="{{ asset('js/hide_show_th.js') }}" defer></script>
  <script src="{{ asset('js/total_col.js') }}" defer></script>
  <script src="{{ asset('js/change_title.js') }}" defer></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script>
    let clanId = {{ clanId|json_encode|raw }};
  </script>


{% endblock extra_styles %}


{% block body %}
  
  <div id="clanId" style="display: none;">{{ clanId }}</div>
  <div id="cwlDate" style="display: none;">{{ cwlDate }}</div>
  {% if popup_active %}
    <style>
      /* Backdrop plein écran */
      .overlay-backdrop{
        position: fixed; inset: 0; background: rgba(0,0,0,.45);
        z-index: 9998;
      }
      /* Modale centrée, hors flux */
      .overlay-modal{
        position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;
        z-index: 9999;
      }
      /* Contenu de ta popup (réutilise ton design actuel) */
      .overlay-modal .popup_container{
        width: min(92vw, 640px);
        border-radius: 12px;
        box-shadow: 0 20px 60px rgba(0,0,0,.25);
        padding: 24px;
      }
      /* Empêche la page de scroller quand la modale est ouverte */
      body.modal-open{ overflow: hidden; }
    </style>

    <div class="overlay-backdrop" id="statusBackdrop" aria-hidden="true"></div>

    <div class="overlay-modal" id="statusPopup" role="dialog" aria-modal="true"
         aria-labelledby="statusTitle" aria-describedby="statusDesc">
      <div class="popup_container beige">
        <div class="infos_container green">
          <div class="infos_title" id="statusTitle">Information</div>
          <hr class="viewcwl_hr">
          <div class="infos_content" id="statusDesc">
            <H2>Une erreur est survenue lors de la récupération de la CWL.</H2>
            <H4>{{ message }}</H4>
            <H4>Les données de tests vont être affichées pour vous permettre d'avoir un aperçu du fonctionnement.</H4>
          </div>
        </div>
        <button class="contest_button" id="statusOkButton">OK</button>
      </div>
    </div>

    <script>
      (function(){
        const body = document.body;
        const pop = document.getElementById('statusPopup');
        const bd  = document.getElementById('statusBackdrop');
        const ok  = document.getElementById('statusOkButton');

        function open(){ body.classList.add('modal-open'); }
        function close(){
          body.classList.remove('modal-open');
          pop?.remove(); bd?.remove();
        }

        open();
        ok?.addEventListener('click', close);
        bd?.addEventListener('click', close);                // fermer au clic extérieur
        document.addEventListener('keydown', e => { if(e.key==='Escape') close(); }); // fermer avec Échap
        setTimeout(() => ok?.focus(), 0);                    // focus accessible
      })();
    </script>
  {% endif %}

  <div class="body_container">
    <div class="title_container beige">
      <span class="underline">{{ clanName }}</span>
      <span class="underline">(#{{ clanId }})</span>
      <span> - </span>
      <span class="underline" id ="title_date">Mois</span>
    </div>
    <div class="data_container">




    <div class="table_container">
      <table id="cwl_table">
        <thead>
        <tr>
          <th><span class="hide_text">Hide</span></th>
          <th>Membre</th>
          <th>J1</th>
          <th>J2</th>
          <th>J3</th>
          <th>J4</th>
          <th>J5</th>
          <th>J6</th>
          <th>J7</th>
          <th class="th_more"><span class="hide_text">More</span></th>
          <th class="th_total">Total</th>
        </tr>
        </thead>
        <tbody>


        {% for p in players %}
          {% set key = p.key %}
          {% set name = p.name %}
          <tr>
            <td class="td_icon">
              <div class="hide_icon_container">
                <img src="{{ asset('./svg/hide.svg') }}" class="hide_icon" alt="Hide icon">
              </div>
            </td>

            <td class="td_member cwl_td">{{ name ?? key }}</td>

            {% set data_Per_Player = data_All_Players[key] ?? [] %}
            {% set currentDay = 1 %}

            {% for attack in data_Per_Player %}
              {% set targetDay = attack.getDay()|default(1) %}

              {# remplir les trous UNIQUEMENT si targetDay > currentDay #}
              {% if targetDay > currentDay %}
                {% for _ in currentDay..(targetDay - 1) %}
                  <td class="td_value"></td>
                {% endfor %}
              {% endif %}

              {% set value = attack.getResult() is defined ? attack.getResult() : '?' %}
              <td class="td_value cwl_td">
                {% set nbPosts = attack.getNbPosts() %}
                {% if nbPosts > 0 %}
                  <img src="{{ asset('./svg/messages_icon.svg') }}" class="message_icon" alt="message icon">
                {% endif %}

                <div
                        {% if value == "1" %}
                          class="value-1 small_box show_popup"
                        {% elseif value == "0" or value == "-1" %}
                          class="value-0 small_box show_popup"
                        {% elseif value == "?" %}
                          class="value-no small_box show_popup"
                        {% elseif value == "1.1" %}
                          class="value-11 small_box show_popup"
                        {% endif %}
                >
                  <input type="text" value="{{ value }}" class="result_day_data" data-key="{{ key }}" disabled aria-label="{{ value }}">
                  <div id="nbPosts" style="display: none">{{ nbPosts }}</div>
                  <div class="hidden_value attackerTH" style="display:none;">{{ attack.getAttackerTH() }}</div>
                  <div class="hidden_value defenderTH" style="display:none;">{{ attack.getDefenderTH() }}</div>
                  <div class="hidden_value stars" style="display:none;">{{ attack.getAttackStars() }}</div>
                  <div class="hidden_value percentage" style="display:none;">{{ attack.getPercentage() }}</div>
                </div>
              </td>

              {% set currentDay = targetDay + 1 %}
            {% endfor %}

            {# compléter jusqu'à J7 uniquement si on n'a pas dépassé #}
            {% if currentDay <= 7 %}
              {% for _ in currentDay..7 %}
                <td class="td_value"></td>
              {% endfor %}
            {% endif %}

            <td class="td_more">
              <label class="label_more small_box">
                <input class="input_more small_box" id="input_more" aria-label="more">
              </label>
            </td>
            <td class="td_total">
              <div class="small_box sum_days" style="cursor: default;"></div>
            </td>
          </tr>
        {% endfor %}


        </tbody>
      </table>
    </div>


    <div class="options_container">
      <div class="edit_mode_container">
        <div class="edit_mode_selector">
          <input type="checkbox" id="edit_mode" name="edit_mode" value="selector" onchange="options_checkbox_changed('edit_mode')" aria-label="edit mode">
        </div>
        <div class="edit_mode_text">
          <label for="edit_mode">
            Enable Edit Mode
          </label>
        </div>
        <button id="saveButton" style="display:none;">Save Changes</button>
      </div>

      <hr style="width: 100%;">

      <div class="options_col_container">
        <div class="options_col_selector">
          <input type="checkbox" id="options_col" name="options_col" value="selector" onchange="options_checkbox_changed('options')" aria-label="options">
        </div>
        <div class="options_col_text">
          <label for="options_col">
            Enable Bonuses Column
          </label>
        </div>
      </div>

      <hr style="width: 100%;">

      <div class="total_col_container">
        <div class="total_col_selector">
          <input type="checkbox" id="total_col" name="total_col" value="selector" onchange="options_checkbox_changed('total')" checked aria-label="total">
        </div>
        <div class="total_col_text">
          <label for="total_col">
            Enable Total Column
          </label>
        </div>
      </div>

      <hr style="width: 100%;">

      <div class="show_members_container">
        <div class="show_members_title">
          <span>
            Hidden members
          </span>
        </div>
        <div class="show_members_name_container">
          {% for p in players %}
            <div class="member member_number_{{ loop.index0 }}">
              <div class="show_members_selector">
                <img src="{{ asset('./svg/hide.svg') }}" class="show_icon" alt="hide icon">
              </div>
              <div class="show_members_text">
                <span>{{ p.name ?? p.key }}</span>
              </div>
            </div>
          {% endfor %}
        </div>

      </div>

    </div>
    </div>
  </div>
  <div class="popup" id="popup">

    <div class="popup_container">

      <div class="infos_container">
        <div class="infos_title">
          Informations:
        </div>
        <hr class="viewcwl_hr">
        <div class="infos_content">blablablabla</div>
      </div>

      <div class="posts_container">
        <div class="posts_title">
          Posts:
        </div>
        <hr class="viewcwl_hr">
        <div class="posts_content" id="posts_content"></div>

      </div>

      <button class="contest_button" id="sendButton">
        Contester
      </button>
    </div>
  </div>
{% endblock body %}