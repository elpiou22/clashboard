              </select>
            </label>
            <span class="star">⭐</span>
            <span>and</span>


            <span>attackerTH</span>

            <label>
              <select name="exceptions_townhalllevels_A[]" class="exceptions_townhalllevels_A">
                <option value="1">1</option>
                <option value="2">2</option>
