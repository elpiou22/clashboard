  <script>
    /**
     * Attache le comportement de masquage/réaffichage de la div "more"
     * en fonction de la valeur du select logical_operator dans une ligne de règle.
     */
    function attachLogicalOperatorListener(ruleRow) {
      const logicalSelect = ruleRow.querySelector('.logical_operator');
      const moreDiv = ruleRow.querySelector('.more');
      if (logicalSelect && moreDiv) {
        logicalSelect.addEventListener('change', function() {
          if (this.value.trim() === "") {
            moreDiv.style.display = 'none';
          } else {
            moreDiv.style.display = 'flex';
          }
        });
        // État initial
        if (logicalSelect.value.trim() === "") {
          moreDiv.style.display = 'none';
        } else {
          moreDiv.style.display = 'flex';
        }
      }
    }

    // Attacher l'événement à toutes les lignes de règles initiales
    document.querySelectorAll('.rule-row').forEach(function(ruleRow) {
      attachLogicalOperatorListener(ruleRow);
    });

    document.querySelectorAll('.remove-rule').forEach(function(button) {
      button.addEventListener('click', function() {
        this.parentElement.remove();
      });
    });


    /**
     * Crée une nouvelle ligne de règle.
     */
    function createClassicalRuleRow() {
      const ruleRow = document.createElement('div');
      ruleRow.classList.add('rule-row');
      ruleRow.innerHTML = `
    <label>
      <select name="stars[]">
        <option value=" "></option>
        <option value="0">0</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
      </select>
    </label>
    <span class="star">⭐</span>

    <label class="operator_box">
      <select name="logical_operator[]" class="logical_operator">
        <option value=" "></option>
        <option value="AND">AND</option>
      </select>
    </label>

    <div class="more">
      <span>attackerTH</span>

      <label>
        <select name="comparison_operator[]" class="comparison_operator">
          <option value="=">=</option>
          <option value=">=">>=</option>
          <option value="<="><=</option>
          <option value="<"><</option>
          <option value=">">></option>
        </select>
      </label>

      <span>defenderTH</span>
    </div>

    <span>=></span>

    <label class="result_box">
      <select name="result[]" class="btn_value_none">
        <option value=" "></option>
        <option value="0">0</option>
        <option value="1">1</option>
        <option value="-1">-1</option>
      </select>
    </label>
  `;

      // Ajout du bouton "Remove"
      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.textContent = 'Remove';
      removeButton.classList.add('remove-rule');

      removeButton.addEventListener('click', function() {
        ruleRow.remove();
      });

      ruleRow.appendChild(removeButton);

      return ruleRow;
    }


    // Ajouter une nouvelle règle lors du clic sur "Add Rule"
    document.getElementById('add-simple-rule').addEventListener('click', function() {
      const newRuleRow = createClassicalRuleRow();
      document.getElementById('classicals-rules-container').appendChild(newRuleRow);
      attachLogicalOperatorListener(newRuleRow);
    });

    /**
     * Crée une nouvelle ligne de règle.
     */
    function createExceptionRuleRow() {
      const ruleRow = document.createElement('div');
      ruleRow.classList.add('rule-row');
      ruleRow.innerHTML = `
                <label>
