{% extends 'layouts/base.html.twig' %}

{% block head %}
  <meta charset="UTF-8">
  <title>CWL forum</title>
  <link rel="stylesheet" href="{{ asset('css/style_cwl.css') }}">
  <link rel="stylesheet" href="{{ asset('css/forum_cwl.css') }}">
{% endblock head %}


{% block body %}

  <div class="title_container">
    <div class="title_playername">
      {{ attack.getPseudo() }}
    </div>
    <div class="title_day">
      Jour {{ attack.getDay() }}
    </div>
  </div>

  <hr class="forum_hr">

  <div class="contest_container">
    <div class="contest_first_div">
      <div class="contest_title">
        Résultat actuel:
      </div>
      <div class="contest_content">
        {{ attack.getResult() }}
      </div>
    </div>


    <div class="contest_text">
      blablbalba
    </div>
  </div>

  <hr class="forum_hr">

  <div class="forum_container">
    <section class="posts_container">

      {% if posts is empty %}
        <div class="post_title">
          <p>Expliquez pourquoi le résultat devrait être modifié:</p>
        </div>
        <section class="tweet-box">
          <form action = "{{ path('post_create') }}" method = "POST">
            <label>
              <textarea name = "content" placeholder="Quoi de neuf ?" required >test1</textarea>
            </label>
            <button type = "submit">Publier</button>
          </form>
        </section>
      {% else %}

        {% for post in posts %}

          <article class="post">
            <div class="author">
              <span>{{ post.getAuthorUsername(entityManager) }}</span>
            </div>
            <div class="content"> {{ post.getText }} </div>
            <div class="actions">
              <button>upvote</button>
              <button>downvote</button>
              <button>reply</button>
            </div>
            <div class="reply_button">
              <form action = "{{ path('post_create') }}" method = "POST">
                <label>
                  <textarea name = "content" placeholder="Quoi de neuf ?" required >test1</textarea>
                </label>
                <button type = "submit">Publier</button>
              </form>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </section>
  </div>

{% endblock body %}