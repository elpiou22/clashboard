<!DOCTYPE html>
{% block html %}
<html lang="fr">
<head>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% block head %}
    <title>{% block title %}Default{% endblock title %}</title>
    <link rel="stylesheet" {% block style %}href="{{ asset('css/style.css') }}"{% endblock style %}>
{% endblock head %}
{% block extra_styles %}{% endblock extra_styles %}
<link rel="stylesheet" href="{{ asset('css/background.css') }}">
<link rel="stylesheet" href="{{ asset('css/navbar.css') }}">
<link rel="stylesheet" href="{{ asset('css/fonts.css') }}">
<link rel="stylesheet" href="{{ asset('css/footer.css') }}">
<style>
    body{
        background-image: linear-gradient(rgba(77, 77, 77, 0.7), rgba(80, 80, 80, 0.7)), url("{{ asset('img/forum_cwl_background.jpg') }}");
    }
</style>
</head>
<body>
{% include './layouts/navbar.html.twig' %}
{% block body %}

{% endblock body %}
{% include './layouts/footer.html.twig' %}
</body>
</html>
{% endblock html %}
