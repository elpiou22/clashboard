{% extends './layouts/base.html.twig' %}

{% block title %} Modifier le profil {% endblock title %}

{% block extra_styles %}
    <link rel="stylesheet" href="{{ asset('css/colors.css') }}">
    <link rel="stylesheet" href="{{ asset('css/style_legis.css') }}">
    <link rel="stylesheet" href="{{ asset('css/margins.css') }}">
{% endblock extra_styles %}

{% block body %}

<div class="body_container">
    <div class="beige">

    {{ form_start(registrationForm, {'attr': {'enctype': 'multipart/form-data', 'class': 'formform'}}) }}
    {{ form_row(registrationForm.email) }}
    {{ form_row(registrationForm.pseudo) }}
    {{ form_row(registrationForm.birthdate) }}
    {{ form_row(registrationForm.profilePictureFile) }}
    <button type="submit" class="btn-login grn_btn">Enregistrer</button>
    {{ form_end(registrationForm) }}

    </div>
</div>

{% endblock body %}
